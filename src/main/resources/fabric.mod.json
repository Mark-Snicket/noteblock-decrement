{
	"schemaVersion": 1,
	"id": "noteblock-decrement",
	"version": "${version}",
	"name": "Noteblock Decrement",
	"description": "Adds the Noteblock decrement stick, allowing you to decrement the note of a noteblock",
	"authors": [
		"Mark"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "MIT",
	"icon": "assets/noteblock-decrement/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.mark.noteblockdecrement.NoteblockDecrement"
		],
		"client" : [
			"net.mark.noteblockdecrement.NoteblockDecrementClient"
		]
	},
	"mixins": [
		"noteblock-decrement.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.3",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}